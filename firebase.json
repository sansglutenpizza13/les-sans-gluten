{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "VERSION.txt", "VERIFY.txt", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
      {"source": "**/*.@(png|jpg|jpeg|webp|svg|css|js)", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]}
    ]
  }
}
